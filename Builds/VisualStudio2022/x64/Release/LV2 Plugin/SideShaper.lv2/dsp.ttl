<https://github.com/DustinMorri/>
	ui:ui <https://github.com/DustinMorri/:UI> ;
	a lv2:Plugin ;
	doap:name "SideShaper" ;
	doap:description "SideShaper" ;
	lv2:minorVersion 0 ;
	lv2:microVersion 0 ;
	doap:maintainer [
		a foaf:Person ;
		foaf:name "DustinMorrisonAudio" ;
		foaf:homepage <https://github.com/DustinMorri/> ;
		foaf:mbox <dustin.morri@gmail.com> ;
	] ;
	doap:release [
		a doap:Version ;
		doap:revision "1.0.0" ;
	] ;
	lv2:optionalFeature
		lv2:hardRTCapable ;
	lv2:extensionData
		state:interface ;
	lv2:requiredFeature
		urid:map ,
		opts:options ,
		bufs:boundedBlockLength ;
	pg:mainInput plug:input_group_1 ;
	pg:mainOutput plug:output_group_1 ;
